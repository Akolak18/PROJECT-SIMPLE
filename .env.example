# Previo PMS credentials
# Copy this file to .env and fill in your details
PREVIO_USERNAME=your_email@example.com
PREVIO_PASSWORD=your_password
PREVIO_HOTEL_ID=768458

# How often to auto-refresh reservations (in seconds)
REFRESH_INTERVAL=60

# Flask settings
FLASK_SECRET_KEY=change-this-to-a-random-string
FLASK_PORT=5000
