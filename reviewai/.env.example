# ─────────────────────────────────────────────────────────
# ReplyFast AI — Environment Configuration
# Copy this file to .env and fill in your credentials.
# ─────────────────────────────────────────────────────────

# Flask
SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development
FLASK_PORT=5001

# Database (SQLite for dev — set a PostgreSQL URL for production)
# DATABASE_URL=postgresql://user:pass@localhost/reviewai_db

# ── AI ──────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ── Stripe ──────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — create these in your Stripe dashboard as
# recurring monthly subscription products:
#   Starter  — $49/month
#   Growth   — $99/month
#   Agency   — $249/month
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_AGENCY=price_...

# ── App ─────────────────────────────────────────────────
APP_URL=http://localhost:5001
